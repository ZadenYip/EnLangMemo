{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "esModuleInterop": true,
    "module": "es2022",
    "moduleResolution": "bundler",
    "rootDir": "..",
    "outDir": "../out-tsc/spec",
    "typeRoots": ["../node_modules/@types", "../node_modules"],
    "types": [
      "vitest/globals",
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.spec.ts",
    "**/*.d.ts",
    "**/*types.ts",
    "../app/ipc/ipc-api.ts",
    "../app/ipc/ipc-service.ts",
    "../app/**/*-interface.ts",
    "../app/**/*-types.ts",
    "../app/subtitle-handler/types.ts",
    "../app/network/errors.ts"
  ],
  "exclude": [
    "dist",
    "release",
    "node_modules"
  ]
}
